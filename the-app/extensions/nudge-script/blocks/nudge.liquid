{% comment %}
  Nudge Banner - Theme App Extension Block
  Only loads on product pages for optimal performance
{% endcomment %}

{% if template.name == 'product' %}
  <script
    src="{{ shop.url }}/apps/nudge/nudge-script.js?shop={{ shop.permanent_domain }}&v=2"
    defer
  ></script>
{% endif %}

{% schema %}
{
  "name": "Nudge Banner",
  "target": "body",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
