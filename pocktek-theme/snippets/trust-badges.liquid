{%- doc -%}
  Trust badges displayed below buy buttons to increase conversion
  Shows secure checkout, shipping, and guarantee information
{%- enddoc -%}

<div class="trust-badges">
  <div class="trust-badges__item">
    <svg class="trust-badges__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <span class="trust-badges__text">Secure Checkout</span>
  </div>
  <div class="trust-badges__item">
    <svg class="trust-badges__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M5 12h14M12 5l7 7-7 7"/>
    </svg>
    <span class="trust-badges__text">Fast Shipping</span>
  </div>
  <div class="trust-badges__item">
    <svg class="trust-badges__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="trust-badges__text">Worldwide Shipping</span>
  </div>
</div>

<style>
  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(var(--color-foreground-rgb), 0.1);
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .trust-badges__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .trust-badges__text {
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .trust-badges {
      justify-content: center;
    }
  }
</style>
